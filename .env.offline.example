# Copy to customer.env, edit it on the connected preparation machine, then
# transfer it with the offline bundle. Keep this file mode 0600.

# The image/path values below are overwritten by install-offline.sh so they
# always match the installed bundle.
AGENTICSRE_IMAGE=agenticsre-offline:replace-me
AGENTICSRE_ENV_FILE=/var/lib/agenticsre/config/agenticsre.env
AGENTICSRE_DATA_DIR=/var/lib/agenticsre/data
AGENTICSRE_LOG_DIR=/var/lib/agenticsre/logs
AGENTICSRE_KUBECONFIG_FILE=/var/lib/agenticsre/kube/config
AGENTICSRE_SSH_DIR=/var/lib/agenticsre/ssh
AGENTICSRE_OFFLINE_MODE=true
SKILL_RUNTIME_PORT=8090

# LLM configuration. In a physically isolated environment this normally points
# to an on-prem OpenAI-compatible gateway. Leave LLM_API_KEY empty to keep all
# deterministic/non-LLM functions available while disabling LLM calls.
LLM_API_KEY=
LLM_BASE_URL=http://10.0.0.10:8000/v1
LLM_MODEL=deepseek-v4-pro

# Web login. Change all three values before customer delivery.
AGENTICSRE_AUTH_ENABLED=true
AGENTICSRE_AUTH_USERNAME=admin
AGENTICSRE_AUTH_PASSWORD=change-me-before-delivery
AGENTICSRE_AUTH_TOKEN=change-me-to-a-long-random-token

AGENTICSRE_NO_PROXY=localhost,127.0.0.1,::1,.svc,.cluster.local,10.0.0.0/8
