# ══════════════════════════════════════════════════════════════════════
# AgenticSRE  ·  Environment Variables
# ──────────────────────────────────────────────────────────────────────
# 复制为 .env 并按需填写。.env 已加入 .gitignore，不会被提交。
# 这里设置的变量会注入到容器进程，YAML 配置里 ${VAR_NAME} 占位符会被替换。
# ══════════════════════════════════════════════════════════════════════

# ─── [必填] 大模型 API Key ──────────────────────────────────────────
# 用于所有 Agent 的 LLM 推理。configs/config.yaml > llm.api_key 默认
# 用 ${LLM_API_KEY} 占位，这里填实际值即可。
#
# Provider 切换: 改 configs/config.yaml 里的 llm.base_url / llm.model；
# 该文件内已附 DeepSeek / OpenAI / 通义千问 / 自建 vLLM 预设示例。
LLM_API_KEY=sk-your-api-key-here

# ─── [可选] 持久化目录 ────────────────────────────────────────────────
# 生产/版本化发布建议指向 release 目录之外的稳定绝对路径，确保配置中心、
# 故障模式版本库、运行记录、日志与模型凭据在容器重建及版本切换后仍保留。
# AGENTICSRE_ENV_FILE=/var/lib/agenticsre/agenticsre.env
# AGENTICSRE_DATA_DIR=/var/lib/agenticsre/data
# AGENTICSRE_LOG_DIR=/var/lib/agenticsre/logs

# ─── [可选] Web 登录认证 ───────────────────────────────────────────
# 默认关闭，便于本地开发和自动化测试。远端部署建议开启。
# 开启后浏览器访问 / 会跳转到 /login；/api/health 保持公开用于容器健康检查。
# 自动化脚本可设置 AGENTICSRE_AUTH_TOKEN，并在请求头中携带
# Authorization: Bearer <token>。
# 如果容器环境变量不方便改，也可写入 data/auth_config.json：
# {"enabled": true, "username": "admin", "password": "change-me", "token": "api-token"}
AGENTICSRE_AUTH_ENABLED=false
AGENTICSRE_AUTH_USERNAME=admin
# 开启认证前必须设置唯一密码；示例不提供可直接使用的默认密码。
AGENTICSRE_AUTH_PASSWORD=
# AGENTICSRE_AUTH_TOKEN=change-me-for-api-clients
# AGENTICSRE_AUTH_SESSION_TTL_SECONDS=28800
# 浏览器演示脚本单独读取登录密码，必要时设置为服务当前使用的密码。
# AGENTICSRE_DEMO_PASSWORD=

# ─── 其他 Provider Key (按选用的 provider 填一个就行) ───────────────
# 选用某 provider 时，把 configs/config.yaml > llm.api_key 改成对应
# ${OPENAI_API_KEY} / ${DASHSCOPE_API_KEY} 等占位符，再来这里填值。
#
# DEEPSEEK_API_KEY=sk-...                            # DeepSeek 官方
# OPENAI_API_KEY=sk-...                              # OpenAI 官方
# DASHSCOPE_API_KEY=sk-...                           # 阿里 DashScope (通义千问)
# OPENROUTER_API_KEY=sk-or-...                       # OpenRouter (聚合网关)
# ANTHROPIC_API_KEY=sk-ant-...                       # Anthropic 官方

# ─── [可选] LLM 端点覆盖 ────────────────────────────────────────────
# 默认走 configs/config.yaml > llm.base_url，按 provider 在 yaml 里改即可。
# 如果你想不改 yaml，也可在这里覆盖（代码不直接读这个变量，需要先在
# yaml 里把 base_url 改成 ${LLM_BASE_URL} 占位）。
# LLM_BASE_URL=https://api.deepseek.com

# ─── [可选] K8s 远程跳板 ────────────────────────────────────────────
# 仅当 SRE 容器跑在远端、不在 K8s 节点上时需要。容器内 use_ssh=false
# 时这些不会被使用。
# K8S_SSH_JUMP=<jump-user>@<jump-host>
# K8S_SSH_TARGET=<target-user>@<target-host>

# ─── [可选] 观测后端地址 ────────────────────────────────────────────
# 这些通常在 configs/config.yaml > observability 里写死。仅在你想
# per-env 切换 (dev/staging/prod) 时用环境变量覆盖。
# PROMETHEUS_URL=http://localhost:9090
# ELASTICSEARCH_URL=http://localhost:9200
# JAEGER_URL=http://localhost:16686
# GRAFANA_URL=http://localhost:3000

# ─── [可选] 智算故障实验目标覆盖 ──────────────────────────────────
# 密码不要写入 .env 或仓库。裸机故障注入建议改用 SSH key/agent。
# AGENTICSRE_NO_PROXY=localhost,127.0.0.1,::1,.svc,.cluster.local,<internal-host>,<jump-host>
# LLM_FAULT_JUMP_HOST=<jump-host>
# LLM_FAULT_JUMP_USER=<jump-user>
# LLM_FAULT_EXTRA_NAME=<gpu-validation-target-name>
# LLM_FAULT_EXTRA_HOST=<gpu-host>
# LLM_FAULT_EXTRA_USER=<gpu-user>
# LLM_FAULT_EXTRA_GPU=<gpu-model-summary>
# LLM_FAULT_T4_127_HOST=<gpu-host>
# LLM_FAULT_T4_127_USER=<gpu-user>
# LLM_FAULT_T4_127_JUMP=<jump-user>@<jump-host>
# LLM_FAULT_T4_127_GPU=NVIDIA T4 x3
# LLM_FAULT_T4_127_PASSWORD_ENV=LLM_FAULT_T4_127_PASSWORD
# LLM_FAULT_T4_127_JUMP_PASSWORD_ENV=LLM_FAULT_JUMP_PASSWORD
# LLM_FAULT_T4_128_HOST=<gpu-host>
# LLM_FAULT_T4_128_USER=<gpu-user>
# LLM_FAULT_T4_128_JUMP=<jump-user>@<jump-host>
# LLM_FAULT_T4_128_GPU=NVIDIA T4 x3
# LLM_FAULT_T4_128_PASSWORD_ENV=LLM_FAULT_T4_128_PASSWORD
# LLM_FAULT_T4_128_JUMP_PASSWORD_ENV=LLM_FAULT_JUMP_PASSWORD
# 校园网 T4 验证集群示例（填到本机 .env，不要在仓库里保存密码）:
# LLM_FAULT_JUMP_HOST=<campus-jump-host>
# LLM_FAULT_JUMP_USER=<campus-jump-user>
# LLM_FAULT_T4_127_HOST=<t4-host-1>
# LLM_FAULT_T4_127_USER=root
# LLM_FAULT_T4_127_JUMP=<campus-jump-user>@<campus-jump-host>
# LLM_FAULT_T4_127_PASSWORD_ENV=LLM_FAULT_T4_127_PASSWORD
# LLM_FAULT_T4_127_JUMP_PASSWORD_ENV=LLM_FAULT_JUMP_PASSWORD
# LLM_FAULT_T4_128_HOST=<t4-host-2>
# LLM_FAULT_T4_128_USER=root
# LLM_FAULT_T4_128_JUMP=<campus-jump-user>@<campus-jump-host>
# LLM_FAULT_T4_128_PASSWORD_ENV=LLM_FAULT_T4_128_PASSWORD
# LLM_FAULT_T4_128_JUMP_PASSWORD_ENV=LLM_FAULT_JUMP_PASSWORD

# ─── [可选] 向量库 ──────────────────────────────────────────────────
# 当 configs/config.yaml > memory.backend = chromadb 时生效。
# CHROMA_PERSIST_DIR=./data/chroma

# ─── [可选] Web 端口 ────────────────────────────────────────────────
# 默认 8080；要改的话同时修改 docker-compose.yaml 的 healthcheck URL。
# WEB_PORT=8080
# AGENTICSRE_IMAGE=agenticsre:20260627

# ─── [可选] Skill Runtime ───────────────────────────────────────────
# 独立 Skill Runtime 默认监听 8090；Web 容器默认访问 http://127.0.0.1:8090。
# 未启动独立 runtime 时，Agent+Skill 路径会自动退回本地桥接执行。
# SKILL_RUNTIME_PORT=8090
# SKILL_RUNTIME_URL=http://127.0.0.1:8090

# ─── [可选] 离线部署后置操作 ───────────────────────────────────────
# start-all.sh 仅在显式设置这些变量时执行对应后置操作。
# AGENTICSRE_EXPOSE_DEATHSTARBENCH=1
# DEATHSTARBENCH_NAMESPACE=test-social-network
# DEATHSTARBENCH_SERVICE=nginx-thrift
# DEATHSTARBENCH_SERVICE_PORT=8080
# DEATHSTARBENCH_TARGET_PORT=8080
# DEATHSTARBENCH_NODE_PORT=<node-port>
# JAEGER_SAMPLING_NAMESPACE=<namespace>
# JAEGER_SAMPLING_CONFIGMAP=<configmap>
# JAEGER_SAMPLING_KEY=jaeger-config.yml
# JAEGER_SAMPLING_PARAM=1.0

# ─── [可选] 离线包维护/验证工具 ───────────────────────────────────
# scripts/prune_offline_image_archives.sh 默认 dry-run，只列出将删除的旧镜像。
# OFFLINE_IMAGE_DIR=./images
# OFFLINE_IMAGE_PRUNE_DRY_RUN=1
# OFFLINE_IMAGE_PRUNE_PATTERNS=coredns:*1.14*,local-path-provisioner:*v0.0.36*,traefik:*3.6*
# scripts/inspect_image_archive_arches.py 可检查镜像 tar 架构，例如：
# python3 scripts/inspect_image_archive_arches.py ./images/*.tar.gz --match vllm-ascend --require-arch arm64
# DOC_STALE_BEFORE=20260601
# scripts/select_ascend_device.sh 可避开故障/占用卡号并可选 patch Deployment。
# ASCEND_EXCLUDE_DEVICES=3
# ASCEND_PREFERRED_DEVICE=
# ASCEND_PATCH_NAMESPACE=<namespace>
# ASCEND_PATCH_DEPLOYMENT=<deployment>
# ASCEND_PATCH_CONTAINER=<container>

# ─── [可选] Jaeger 兼容性验证/UDP 桥接 ────────────────────────────
# scripts/audit_jaeger_ingest.sh 会检查 Jaeger 镜像是否仍使用 latest、
# 服务是否暴露 UDP 6831，以及 API 是否可读。
# JAEGER_NAMESPACE=observability
# JAEGER_SERVICE=jaeger
# JAEGER_APP_SELECTOR=app.kubernetes.io/name=jaeger
# scripts/deploy_jaeger_udp_agent_bridge.sh 为旧 UDP 客户端部署 v1 agent 桥接层。
# JAEGER_AGENT_NAMESPACE=observability
# JAEGER_AGENT_IMAGE=jaegertracing/jaeger-agent:1.64.0
# JAEGER_AGENT_REPORTER_PROTOCOL=grpc
# JAEGER_COLLECTOR_HOST_PORT=jaeger:14250

# ─── [可选] K3S/DeathStarBench 现场风险检查 ──────────────────────
# scripts/install_k3s_image_import_service.sh 会安装 systemd oneshot，
# 在 K3S 启动后自动导入离线镜像到 containerd k8s.io namespace。
# K3S_IMAGE_IMPORT_DIR=<offline-image-dir>
# K3S_IMAGE_IMPORT_SERVICE=agenticsre-k3s-image-import
# scripts/verify_deathstarbench_hostpath.sh 验证 nginx hostPath 所需文件。
# DSB_NGINX_HOSTPATH=<nginx-hostpath-dir>
# DSB_NGINX_REQUIRED_FILES=<file1>,<file2>
